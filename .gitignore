/android/build/
/android/.build_version

# Firebase config — APK'ya zaten gömülüyor ama herkese açık depoya konmasın
/google-services.json

# Build outputs
*.apk
*.aab
*.idsig
*.ipa
export/

# OS junk
.DS_Store
Thumbs.db
